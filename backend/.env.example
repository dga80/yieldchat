# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Gemini API (Google AI Studio) - Admite múltiples claves para rotación y balanceo de cuotas
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
# O bien lista separada por comas:
# GEMINI_API_KEYS=key1,key2,key3

# Opcional: sobreescribir modelo (por defecto auto-descubre la versión Flash más reciente)
# GEMINI_MODEL=gemini-3.7-flash

# GitHub Token (necesario en Render para que el backend pueda hacer push de los cambios al repo)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
